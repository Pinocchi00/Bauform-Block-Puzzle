          "action": {
            "@android:name": "androidx.profileinstaller.action.INSTALL_PROFILE"
          }
        },
        {
          "action": {
            "@android:name": "androidx.profileinstaller.action.SKIP_FILE"
          }
        },
        {
          "action": {
            "@android:name": "androidx.profileinstaller.action.SAVE_PROFILE"
