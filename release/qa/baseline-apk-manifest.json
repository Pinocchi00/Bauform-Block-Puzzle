{
  "@xmlns:android": "http://schemas.android.com/apk/res/android",
  "@android:versionCode": "2",
  "@android:versionName": "1.0.2",
  "@android:compileSdkVersion": "36",
  "@android:compileSdkVersionCodename": "16",
  "@package": "io.github.pinocchi00.bauform.debug",
  "@platformBuildVersionCode": "36",
  "@platformBuildVersionName": "16",
  "uses-sdk": {
    "@android:minSdkVersion": "24",
    "@android:targetSdkVersion": "36"
  },
  "uses-permission": [
    {
      "@android:name": "android.permission.INTERNET"
    },
    {
      "@android:name": "android.permission.VIBRATE"
    },
    {
      "@android:name": "io.github.pinocchi00.bauform.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
    }
  ],
  "permission": {
    "@android:name": "io.github.pinocchi00.bauform.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION",
    "@android:protectionLevel": "0x00000002"
  },
  "application": {
    "@android:theme": "@7F0E0005",
    "@android:label": "@7F0D001C",
    "@android:icon": "@7F0C0000",
    "@android:debuggable": "true",
    "@android:allowBackup": "true",
    "@android:supportsRtl": "true",
    "@android:extractNativeLibs": "false",
    "@android:roundIcon": "@7F0C0002",
    "@android:appComponentFactory": "androidx.core.app.CoreComponentFactory",
    "activity": {
      "@android:theme": "@7F0E0007",
      "@android:label": "@7F0D0029",
      "@android:name": "io.github.pinocchi00.bauform.MainActivity",
      "@android:exported": "true",
      "@android:launchMode": "2",
      "@android:screenOrientation": "1",
      "@android:configChanges": "0x00001FF4",
      "intent-filter": {
        "action": {
          "@android:name": "android.intent.action.MAIN"
        },
        "category": {
          "@android:name": "android.intent.category.LAUNCHER"
        }
      }
    },
    "provider": [
      {
        "@android:name": "androidx.core.content.FileProvider",
        "@android:exported": "false",
        "@android:authorities": "io.github.pinocchi00.bauform.debug.fileprovider",
        "@android:grantUriPermissions": "true",
        "meta-data": {
          "@android:name": "android.support.FILE_PROVIDER_PATHS",
          "@android:resource": "@7F100001"
        }
      },
      {
        "@android:name": "androidx.startup.InitializationProvider",
        "@android:exported": "false",
        "@android:authorities": "io.github.pinocchi00.bauform.debug.androidx-startup",
        "meta-data": [
          {
            "@android:name": "androidx.emoji2.text.EmojiCompatInitializer",
            "@android:value": "androidx.startup"
          },
          {
            "@android:name": "androidx.lifecycle.ProcessLifecycleInitializer",
            "@android:value": "androidx.startup"
          },
          {
            "@android:name": "androidx.profileinstaller.ProfileInstallerInitializer",
            "@android:value": "androidx.startup"
          }
        ]
      }
    ],
    "receiver": {
      "@android:name": "androidx.profileinstaller.ProfileInstallReceiver",
      "@android:permission": "android.permission.DUMP",
      "@android:enabled": "true",
      "@android:exported": "true",
      "@android:directBootAware": "false",
      "intent-filter": [
